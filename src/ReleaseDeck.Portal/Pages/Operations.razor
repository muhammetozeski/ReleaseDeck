@page "/operations"
@page "/operations/{Id}"
@inherits DeckPage
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>Delivery · Release Deck</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Channel delivery</p><h1>Deliver an approved release.</h1><p>Upload privately first. Publishing is a separate decision.</p></div><button disabled="@Busy" @onclick="Refresh">Refresh status</button></div><Notice Text="@Message" Error="@Failed" />
@if(View is null){<section class="empty"><h2>Save a release online to begin.</h2><a class="button primary" href="workspace">Open workspace</a></section>}else if(!IsOwner){<section class="empty"><h2>The release owner manages channel delivery.</h2><p>You can prepare the release and leave feedback in Team review.</p><a class="button" href="@("review/"+View.Id)">Open review</a></section>}else{
<div class="delivery-summary"><div><h2>@View.Title</h2><p>Version @View.Revision · @(LocalChanges?"Local changes are not saved":Approved?"Approved for delivery":"Needs owner approval")</p></div><a class="button" href="@("review/"+View.Id)">Review this version</a></div>
@if(LocalChanges){<div class="notice">Save your local changes online, then approve the new version before delivery. <a href="@("workspace/"+View.Id)">Open your edits</a></div>}<section class="connection-panel"><div><h2>YouTube channel</h2>@if(Channels.Count==0){<p>@(Configuration?.GoogleConfigured==true?"Connect the channel you own to deliver this release.":"Channel connection is not available yet. You can prepare and download the release now.")</p>}else{<label>Deliver to<select @bind="ConnectionId" @bind:after="ChannelChanged" disabled="@Busy">@foreach(var channel in Channels){<option value="@channel.Id">@channel.Title</option>}</select></label>}</div><div class="actions"><button disabled="@(Busy||Configuration?.GoogleConfigured!=true)" @onclick="Connect">Connect a channel</button>@if(ConnectionId.Length>0){<button disabled="@Busy" @onclick="Disconnect">Disconnect</button>}</div></section>
<div class="notice">Videos transfer directly from this device to Google. Everyone can keep editing the plan; only the owner can start delivery.</div>
<label class="check-line"><input type="checkbox" @bind="ConfirmPrivate" disabled="@Busy">Upload these originals privately to the selected channel.</label>
<div class="delivery-list">@foreach(var episode in View.Body.Episodes){var operation=Receipts.Where(item=>item.EpisodeId==episode.Id).OrderByDescending(item=>item.CreatedAt).FirstOrDefault();var binding=MatchingBinding(episode);var choice=Publication(operation?.Id??episode.Id);<article class="delivery-episode"><div class="delivery-episode-heading"><span class="episode-number">@(View.Body.Episodes.IndexOf(episode)+1)</span><div><h3>@episode.Title</h3><p class="quiet">@(episode.File?.Name??"No identified original")</p></div><span class="badge">@(operation is null?"Not uploaded":Status(operation))</span></div>
@if(operation is null){<div class="actions"><button class="primary" disabled="@(Busy||!Approved||!ConfirmPrivate||ConnectionId.Length==0||binding is null||Configuration?.GoogleConfigured!=true)" @onclick="()=>Start(episode)">Upload privately</button>@if(binding is null){<a href="@("workspace/"+View.Id)">Reattach the matching video</a>}</div>}else{
<div class="transfer-meter"><progress value="@operation.Offset" max="@Math.Max(operation.TotalBytes,1)" aria-label="Confirmed upload bytes"></progress><span>@Bytes(operation.Offset) / @Bytes(operation.TotalBytes) confirmed</span></div>
@if(Progress.TryGetValue(operation.Id,out var progress)){<p class="quiet" role="status">@progress</p>}
@if(operation.Uncertain||operation.Status is "unknown_init" or "uncertain"){<p class="notice">The last action has not been confirmed. Check its remote status before continuing.</p>}
@if(!string.IsNullOrWhiteSpace(operation.Error)){<p class="notice error">@operation.Error</p>}
<div class="actions"><button disabled="@Busy" @onclick="()=>Reconcile(operation)">Check remote status</button>@if(operation.Status is "ready" or "uploading" or "uncertain"){<button disabled="@(Busy||binding is null)" @onclick="()=>Transfer(operation,episode,true)">Resume transfer</button>}@if(UploadingId==operation.Id){<button @onclick="()=>Pause(operation)">Pause transfer</button>}@if(operation.Status is not "canceled" and not "complete"){<button disabled="@Busy" @onclick="()=>Cancel(operation)">Cancel transfer access</button>}@if(operation.VideoId is not null){<a class="button" href="@VideoUrl(operation.VideoId)" target="_blank" rel="noopener">Open on YouTube</a>}</div>
@if(operation.VideoId is not null&&operation.Status=="complete"){
<details><summary>Update or publish this video</summary><p>Apply approved metadata first. Choose visibility only when you are ready.</p><button disabled="@(Busy||!Approved)" @onclick="()=>UpdateMetadata(operation)">Apply approved metadata</button>@if(operation.AppliedRevision!=View.Revision){<p class="quiet">Apply this approved version before changing visibility.</p>}<label>Visibility<select @bind="choice.Visibility" disabled="@Busy"><option value="private">Private</option><option value="unlisted">Unlisted</option><option value="public">Public</option></select></label><label class="check-line"><input type="checkbox" @bind="choice.Confirmed" disabled="@Busy">I approve this visibility change for this video.</label><button class="primary" disabled="@(Busy||!Approved||!choice.Confirmed||operation.AppliedRevision!=View.Revision)" @onclick="()=>Publish(operation,episode)">Apply visibility</button><p class="quiet">A planned future time is used only for a public release. Each video is applied separately.</p></details>}
@if(operation.VideoId is null&&operation.Status is "failed" or "expired" or "canceled" or "unknown_init"){<details><summary>Start a separate attempt</summary><p>An earlier private video may already exist. Check the original channel before starting another attempt.</p><label class="check-line"><input type="checkbox" @bind="choice.RestartConfirmed" disabled="@Busy">I accept the possible duplicate and want a separate private attempt in the original channel.</label><button disabled="@(Busy||!Approved||!choice.RestartConfirmed||binding is null||Configuration?.GoogleConfigured!=true)" @onclick="()=>Restart(operation,episode)">Start separate private attempt</button></details>}<details><summary>Saved transfer records</summary><ol class="operation-history">@foreach(var receipt in Receipts.Where(item=>item.EpisodeId==episode.Id).OrderByDescending(item=>item.CreatedAt)){<li>@Status(receipt) · version @receipt.Revision · @DateTimeOffset.FromUnixTimeMilliseconds(receipt.UpdatedAt).ToLocalTime().ToString("MMM d, HH:mm")</li>}</ol></details>
}</article>}</div>}
@code {
 [Parameter]public string? Id{get;set;} Workspace? View; ServiceConfiguration? Configuration;List<ChannelConnection> Channels=[];List<RemoteOperation> Receipts=[];string ConnectionId="";bool ConfirmPrivate,LocalChanges;Dictionary<string,PublishChoice> PublicationChoices=[];IJSObjectReference? Uploader;DotNetObjectReference<Operations>? Reference;string? UploadingId;Dictionary<string,string> Progress=[];Dictionary<string,string> UploadRequests=[];Dictionary<string,RemoteIntent> Intents=[];
 PublishChoice Publication(string id){if(!PublicationChoices.TryGetValue(id,out var choice)){choice=new();PublicationChoices[id]=choice;}return choice;}
 void ChannelChanged()=>ConfirmPrivate=false;
 sealed class PublishChoice{public string Visibility{get;set;}="private";public bool Confirmed{get;set;}public bool RestartConfirmed{get;set;}}
 bool IsOwner=>View is {Role:"owner",ArchivedAt:null};bool Approved=>View is not null&&View.ApprovedRevision==View.Revision&&!LocalChanges;
 protected override async Task OnParametersSetAsync(){await Act(async()=>{await Store.Initialize();Id??=Store.Active.WorkspaceId;if(Id is not null)await Read();},allowWhileBusy:true);}
 async Task Read(){var target=Id;if(target is null)return;var result=await Api.Get<WorkspaceEnvelope>("workspaces/"+target);if(Disposed||Id!=target)return;View=result.Workspace;LocalChanges=Store.Active.WorkspaceId==View.Id&&JsonSerializer.Serialize(Store.Active.Body,ReleaseRules.PortableJson)!=JsonSerializer.Serialize(View.Body,ReleaseRules.PortableJson);if(!IsOwner)return;Configuration=await Api.Get<ServiceConfiguration>("config");if(Disposed||Id!=target)return;var channels=await Api.Get<ConnectionList>("connections");if(Disposed||Id!=target)return;Channels=channels.Connections;if(!Channels.Any(item=>item.Id==ConnectionId))ConnectionId=Channels.FirstOrDefault()?.Id??"";await ReadOperations();}
 async Task ReadOperations(){var target=Id;if(target is null)return;var result=await Api.Get<OperationList>("workspaces/"+target+"/operations");if(!Disposed&&Id==target)Receipts=result.Operations;}
 Task Refresh()=>Act(Read);
 Task Connect()=>Act(async()=>{var result=await Api.Post<AuthorizationDestination>("oauth/start",new{requestId=Guid.NewGuid().ToString()});var url=new Uri(result.AuthorizationUrl);if(url.Scheme!="https"||url.Host!="accounts.google.com"||url.Port!=443||url.UserInfo.Length>0)throw new InvalidDataException("The channel authorization address was not accepted.");Navigation.NavigateTo(url.AbsoluteUri,forceLoad:true);});
 Task Disconnect()=>Act(async()=>{var result=await Api.Post<DisconnectionResult>("connections/"+ConnectionId+"/disconnect",new{});ConfirmPrivate=false;await Read();Message=result.ProviderRevoked?"Channel disconnected and Google access revoked. No video was deleted.":"Connection removed here. Revoke remaining access in your Google account if needed. No video was deleted.";});
 MediaBinding? MatchingBinding(Episode episode){if(episode.File is null||!Store.Bindings.TryGetValue(episode.Id,out var binding)||!binding.Identified||binding.LocalId!=Store.Active.Id)return null;var local=Store.Active.Body.Episodes.FirstOrDefault(item=>item.Id==episode.Id)?.File;return local is not null&&ReleaseRules.Matches(episode.File,local.Algorithm,local.Fingerprint,local.Size)?binding:null;}
 Task Start(Episode episode)=>Act(async()=>{if(View is null||episode.File is null||MatchingBinding(episode) is null)throw new InvalidDataException("Reattach and identify the matching original first.");var intent=View.Revision+":"+episode.Id;if(!UploadRequests.TryGetValue(intent,out var requestId)){requestId=Guid.NewGuid().ToString();UploadRequests[intent]=requestId;}var result=await Api.Post<OperationEnvelope>("workspaces/"+View.Id+"/uploads",new{requestId,revision=View.Revision,episodeId=episode.Id,connectionId=ConnectionId,fileIdentity=new{algorithm=episode.File.Algorithm,fingerprint=episode.File.Fingerprint,byteLength=episode.File.Size},confirmPrivate=ConfirmPrivate});await TransferCore(result.Operation,episode,false);});
 Task Transfer(RemoteOperation operation,Episode episode,bool resume)=>Act(()=>TransferCore(operation,episode,resume));
 async Task TransferCore(RemoteOperation operation,Episode episode,bool resume){var binding=MatchingBinding(episode)??throw new InvalidDataException("Reattach and identify the matching original first.");Uploader??=await JS.InvokeAsync<IJSObjectReference>("import","./upload.mjs");Reference??=DotNetObjectReference.Create(this);UploadingId=operation.Id;try{await Uploader.InvokeVoidAsync(resume?"resume":"start",operation.Id,binding.ClientFileId,Reference,"OnUploadProgress");}finally{UploadingId=null;if(!Disposed)await ReadOperations();}}
 [JSInvokable]public Task OnUploadProgress(JsonElement progress)
 {
  if(Disposed)return Task.CompletedTask;
  if(progress.TryGetProperty("operationId",out var id)&&id.ValueKind==JsonValueKind.String&&id.GetString() is {} key)
  {
   var phase=progress.TryGetProperty("phase",out var state)&&state.ValueKind==JsonValueKind.String?state.GetString():null;
   var text=progress.TryGetProperty("message",out var message)&&message.ValueKind==JsonValueKind.String?message.GetString():null;
   if(string.IsNullOrWhiteSpace(text))text=phase switch{"checking"=>"Checking the original.","paused"=>"Transfer paused.","uncertain"=>"Check remote status before resuming.","reconciling"=>"Checking remote status.","uploaded"=>"Video transferred.","cancelled"=>"Transfer canceled.","error"=>"The transfer could not continue. Check remote status.",_=>"Transferring video."};
   if(text.Length>500)text=text[..500];
   var confirmed=progress.TryGetProperty("confirmedBytes",out var bytes)&&bytes.TryGetInt64(out var count)&&count>=0?" · "+Bytes(count)+" confirmed":"";
   Progress[key]=text+confirmed;
  }
  return InvokeAsync(StateHasChanged);
 }
 async Task Pause(RemoteOperation operation){if(Uploader is null)return;try{await Uploader.InvokeVoidAsync("pause",operation.Id);}catch(JSException){Message="Pause was not confirmed. Check the remote status before resuming.";Failed=true;}}
 Task Reconcile(RemoteOperation operation)=>Act(async()=>{var result=await Api.Post<OperationEnvelope>("operations/"+operation.Id+"/reconcile",new{});if(!result.Operation.Uncertain&&result.Operation.Status is not "uncertain" and not "unknown_init")foreach(var entry in Intents.Where(item=>item.Key.StartsWith(operation.Id+":",StringComparison.Ordinal)))entry.Value.Pending=false;await ReadOperations();});
 Task Cancel(RemoteOperation operation)=>Act(async()=>{await Api.Post<OperationEnvelope>("operations/"+operation.Id+"/cancel",new{});await ReadOperations();},"Further transfer access canceled. Any video already received by YouTube remains there.");
 Task UpdateMetadata(RemoteOperation operation)=>Act(async()=>{if(View is null)return;var revision=View.Revision;var intent=Intent(operation.Id,"metadata",JsonSerializer.Serialize(new{revision}));await Mutate(operation,"metadata",new{requestId=intent.RequestId,revision},intent);},"Remote metadata checked. Read its returned status before continuing.");
 Task Publish(RemoteOperation operation,Episode episode)=>Act(async()=>{if(View is null)return;var choice=Publication(operation.Id);var visibility=choice.Visibility;var confirmed=choice.Confirmed;var revision=View.Revision;var time=visibility=="public"?episode.PublishAt?.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss.fffZ"):null;var intent=Intent(operation.Id,"publish",JsonSerializer.Serialize(new{revision,visibility,time}));await Mutate(operation,"publish",new{requestId=intent.RequestId,revision,privacyStatus=visibility,publishAt=time,confirm=confirmed},intent);choice.Confirmed=false;},"Visibility action returned. Check its remote status above.");
 Task Restart(RemoteOperation operation,Episode episode)=>Act(async()=>{if(View is null)return;var choice=Publication(operation.Id);var revision=View.Revision;var intent=Intent(operation.Id,"restart",JsonSerializer.Serialize(new{revision}));var result=await Mutate(operation,"restart",new{requestId=intent.RequestId,revision,confirmPrivate=true,confirmPossibleDuplicate=choice.RestartConfirmed},intent);choice.RestartConfirmed=false;await TransferCore(result,episode,false);});
 RemoteIntent Intent(string id,string action,string payload){var key=id+":"+action;if(Intents.TryGetValue(key,out var previous)){if(previous.Payload==payload)return previous;if(previous.Pending)throw new InvalidDataException("An earlier action is unconfirmed. Check remote status before changing its settings.");}var created=new RemoteIntent(payload);Intents[key]=created;return created;}
 async Task<RemoteOperation> Mutate(RemoteOperation operation,string action,object body,RemoteIntent intent){try{var result=await Api.Post<OperationEnvelope>("operations/"+operation.Id+"/"+action,body);intent.Pending=result.Operation.Uncertain||result.Operation.Status is "uncertain" or "unknown_init";await ReadOperations();return result.Operation;}catch(Exception primary){try{await ReadOperations();}catch(Exception refresh){throw new AggregateException("The action and status refresh were not confirmed.",primary,refresh);}throw;}}
 sealed class RemoteIntent(string payload){public string Payload{get;}=payload;public string RequestId{get;}=Guid.NewGuid().ToString();public bool Pending{get;set;}=true;}
 static string Bytes(long value)=>(value/1048576d).ToString("N1")+" MB";
 static string VideoUrl(string id)=>"https://www.youtube.com/watch?v="+Uri.EscapeDataString(id);
 static string Status(RemoteOperation operation)=>operation.Status switch{"unknown_init"=>"Upload start unconfirmed","ready"=>"Ready to transfer","uploading"=>"Transferring","processing"=>"YouTube is processing","complete"=>"Video received","uncertain"=>"Check remote status","canceled"=>"Access canceled",_=>operation.Status.Replace('_',' ')};
 public async ValueTask DisposeAsync(){base.Dispose();if(Uploader is not null){try{await Uploader.InvokeVoidAsync("dispose");await Uploader.DisposeAsync();}catch(JSException){if(Store.DiagnosticLogging)Console.Error.WriteLine("Transfer cleanup was not confirmed.");}}Reference?.Dispose();}
}
