@page "/review"
@page "/review/{Id}"
@inherits DeckPage
<PageTitle>Team review · Release Deck</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Shared decisions</p><h1>Review the release.</h1><p>Leave feedback on a saved version before its owner starts delivery.</p></div>@if(View is not null){<a class="button" href="@("workspace/"+View.Id)">Open workspace</a>}</div><Notice Text="@Message" Error="@Failed" />
@if(View is null){<section class="empty"><h2>Save the release online first.</h2><p>Your local plan is ready to keep editing.</p><a class="button primary" href="workspace">Open workspace</a></section>}else{
<div class="review-grid"><section><div class="review-summary"><h2>@View.Title</h2><span class="badge">Version @View.Revision</span><span class="badge @(View.ApprovedRevision==View.Revision?"good":"")">@(View.ApprovedRevision==View.Revision?"Approved":"Awaiting owner approval")</span></div>
<ol class="review-episodes">@foreach(var episode in View.Body.Episodes){<li><h3>@episode.Title</h3><p>@episode.Description</p><dl><dt>Original</dt><dd>@episode.DefaultLanguage</dd><dt>Video</dt><dd>@(episode.File?.Name??"Not identified")</dd><dt>Planned release</dt><dd>@(episode.PublishAt?.ToLocalTime().ToString("MMM d, yyyy HH:mm")??"Unscheduled")</dd></dl>@foreach(var text in episode.Localizations){<details><summary>@text.Language · @text.Title</summary><p>@text.Description</p></details>}</li>}</ol>
@if(CanReview){<section class="review-form"><label>Feedback<textarea rows="4" maxlength="2000" @bind="Note" @bind:event="oninput" disabled="@Busy"></textarea></label><div class="actions"><button disabled="@(Busy||string.IsNullOrWhiteSpace(Note))" @onclick="Comment">Add comment</button><button disabled="@(Busy||string.IsNullOrWhiteSpace(Note))" @onclick="RequestChanges">Request changes</button>@if(IsOwner){<button class="primary" disabled="@(Busy||!ReadyForApproval)" @onclick="Approve">Approve version @View.Revision</button>}</div>@if(IsOwner&&!ReadyForApproval){<p class="quiet">Complete the required episode details and file identities before approval.</p>}</section>}
<section><div class="section-heading"><h2>Feedback history</h2><button disabled="@Busy" @onclick="Reload">Refresh</button></div>@if(Reviews.Count==0){<p class="quiet">No feedback yet.</p>}@foreach(var review in Reviews.OrderByDescending(item=>item.CreatedAt)){<article class="feedback"><div><strong>@Decision(review.Decision)</strong><span>Version @review.Revision · @DateTimeOffset.FromUnixTimeMilliseconds(review.CreatedAt).ToLocalTime().ToString("MMM d, HH:mm")</span></div><p>@review.Note</p></article>}</section></section>
<aside class="team-panel"><h2>Team access</h2><p class="quiet">Everyone invited can read this release's text and file names. Videos are reattached separately.</p>@if(IsOwner){<label>Invitation role<select @bind="InviteRole" disabled="@Busy"><option value="viewer">Viewer · read</option><option value="editor">Editor · prepare and review</option></select></label><button disabled="@(Busy||View.ArchivedAt is not null)" @onclick="CreateInvite">Create invitation</button>@if(InviteUrl.Length>0){<label>Share this invitation<textarea rows="3" readonly value="@InviteUrl"></textarea></label>}
<details><summary>Open invitations</summary>@foreach(var invite in Invites.Where(item=>item.RevokedAt is null&&!item.Used&&item.ExpiresAt>DateTimeOffset.UtcNow.ToUnixTimeMilliseconds())){<div class="invitation-row"><span>@invite.Role · expires @DateTimeOffset.FromUnixTimeMilliseconds(invite.ExpiresAt).ToLocalTime().ToString("MMM d, HH:mm")</span><button disabled="@Busy" @onclick="()=>Revoke(invite)">Revoke invitation</button></div>}</details><ul class="member-list">@foreach(var member in Members){<li><span>@(member.MemberId.Length>0?member.MemberId:member.Id)<small>@member.Role</small></span>@if(member.Role!="owner"){<div class="actions"><button disabled="@Busy" @onclick="()=>ToggleRole(member)">@(member.Role=="viewer"?"Make editor":"Make viewer")</button><button disabled="@Busy" @onclick="()=>RemoveMember(member)">Remove</button></div>}</li>}</ul><details><summary>@(View.ArchivedAt is null?"Archive release":"Restore release")</summary><p>Archiving closes team access and delivery. It does not delete videos already on YouTube.</p><button disabled="@Busy" @onclick="Archive">@(View.ArchivedAt is null?"Archive this release":"Restore this release")</button></details>}else{<p>The owner manages invitations and channel delivery.</p>}<a class="button" href="@("operations/"+View.Id)">Continue to delivery →</a></aside></div>}
@code {
 [Parameter]public string? Id{get;set;} Workspace? View;List<ReleaseReview> Reviews=[];List<WorkspaceMember> Members=[];List<InvitationSummary> Invites=[];string Note="",InviteRole="viewer",InviteUrl="";
 bool IsOwner=>View?.Role=="owner";bool CanReview=>View is {ArchivedAt:null}&&View.Role is "owner" or "editor";bool ReadyForApproval=>View is not null&&View.Body.Episodes.Count>0&&!ReleaseRules.Preflight(View.Body).Any(item=>item.BlocksUpload);
 protected override async Task OnParametersSetAsync(){await Act(async()=>{await Store.Initialize();Id??=Store.Active.WorkspaceId;if(Id is not null)await Load();},allowWhileBusy:true);}
 async Task Load(){var target=Id;if(target is null)return;var result=await Api.Get<WorkspaceEnvelope>("workspaces/"+target);if(Disposed||Id!=target)return;View=result.Workspace;var reviews=await Api.Get<ReviewList>("workspaces/"+target+"/reviews");if(Disposed||Id!=target)return;Reviews=reviews.Reviews;if(IsOwner){var members=await Api.Get<MemberList>("workspaces/"+target+"/members");if(!Disposed&&Id==target)Members=members.Members;var invitations=await Api.Get<InvitationList>("workspaces/"+target+"/invites");if(!Disposed&&Id==target)Invites=invitations.Invites;}}
 Task Reload()=>Act(Load);
 Task Comment()=>Review("comment"); Task RequestChanges()=>Review("changes_requested"); Task Approve()=>Review("approve"); Task ToggleRole(WorkspaceMember member)=>ChangeRole(member,member.Role=="viewer"?"editor":"viewer"); Task RemoveMember(WorkspaceMember member)=>ChangeRole(member,"remove");
 Task Review(string decision)=>Act(async()=>{if(View is null)return;await Api.Post<JsonElement>("workspaces/"+View.Id+"/reviews",new{revision=View.Revision,decision,note=Note});Note="";await Load();},"Review saved for this version.");
 Task CreateInvite()=>Act(async()=>{if(View is null)return;var result=await Api.Post<Invitation>("workspaces/"+View.Id+"/invites",new{role=InviteRole});InviteUrl=Navigation.BaseUri+"#invite="+Uri.EscapeDataString(result.Token);await Load();},"Invitation ready. Share it only with the intended teammate.");
 Task Revoke(InvitationSummary invite)=>Act(async()=>{if(View is null)return;await Api.Post<JsonElement>("workspaces/"+View.Id+"/invites/"+invite.Id+"/revoke",new{});await Load();},"Invitation revoked.");
 Task ChangeRole(WorkspaceMember member,string role)=>Act(async()=>{if(View is null)return;await Api.Post<JsonElement>("workspaces/"+View.Id+"/members",new{memberId=member.MemberId.Length>0?member.MemberId:member.Id,role});await Load();});
 Task Archive()=>Act(async()=>{if(View is null)return;await Api.Post<JsonElement>("workspaces/"+View.Id+(View.ArchivedAt is null?"/archive":"/restore"),new{});await Load();});
 static string Decision(string value)=>value switch{"approve"=>"Owner approval","changes_requested"=>"Changes requested",_=>"Comment"};
}
