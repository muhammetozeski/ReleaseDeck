@page "/workspace"
@page "/workspace/{Id}"
@inherits DeckPage
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>@Store.Active.Body.Title · Release Deck</PageTitle>
<Notice Text="@Message" Error="@Failed" />
<div class="workspace-top"><div><p class="eyebrow">@(Store.Online is null ? "Local release" : Store.Online.Role + " · version " + Store.Online.Revision)</p><h1>@Store.Active.Body.Title</h1></div><div class="actions"><button disabled="@Busy" @onclick="DownloadProject">Save project file</button><button disabled="@(Busy||Store.Active.Body.Episodes.Count==0)" @onclick="Package">Download release package</button><button class="primary" disabled="@(Busy||!CanEdit)" @onclick="SaveOnline">@(Store.Active.WorkspaceId is null ? "Save online" : "Save changes online")</button></div></div>
@if(Store.Online is { Role:"viewer" }){<div class="notice">You can read this release. <button @onclick="LocalCopy" disabled="@Busy">Make a local copy</button></div>}
@if(Store.Online?.ArchivedAt is not null){<div class="notice">This release is archived. Restore it from Team review to make changes.</div>}
<div class="workspace-grid"><aside class="episode-rail"><div class="section-heading"><h2>Episodes <span class="count">@Store.Active.Body.Episodes.Count</span></h2></div><label class="button primary file-action @(Busy||!CanEdit ? "muted" : "")" for="add-videos">Add videos</label><input id="add-videos" type="file" class="visually-hidden" accept="video/*" multiple @ref="AddInput" @onchange="AddVideos" disabled="@(Busy||!CanEdit)">
@if(Store.Active.Body.Episodes.Count==0){<p class="quiet">Choose your original videos to see the preview and prepare the release.</p>}
<button class="text-button sample-action" disabled="@(Busy||!CanEdit)" @onclick="TrySamples">Try sample clips</button><ol class="episode-list">@foreach(var episode in Store.Active.Body.Episodes){<li><button class="episode-pick @(SelectedId==episode.Id?"selected":"")" @onclick="()=>Select(episode.Id)" disabled="@Busy"><span class="episode-number">@(Store.Active.Body.Episodes.IndexOf(episode)+1)</span><span><strong>@(episode.Title.Length>0?episode.Title:"Untitled episode")</strong><small>@FileStatus(episode)</small></span><span class="issue-count">@Issues.Count(issue=>issue.EpisodeId==episode.Id&&issue.BlocksUpload)</span></button></li>}</ol>
<details class="release-settings"><summary>Release details</summary><label>Release title<input maxlength="120" @bind="Store.Active.Body.Title" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></label><label>Release notes<textarea rows="4" maxlength="2000" @bind="Store.Active.Body.Description" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></textarea></label></details></aside>
<section class="episode-inspector">@if(Selected is {} selected){
<div class="inspector-heading"><div><p class="eyebrow">Episode @(Store.Active.Body.Episodes.IndexOf(selected)+1)</p><h2>@(selected.Title.Length>0?selected.Title:"Prepare this episode")</h2></div><div class="actions"><button title="Move earlier" disabled="@(Busy||!CanEdit||Store.Active.Body.Episodes.IndexOf(selected)==0)" @onclick="()=>Move(-1)">↑</button><button title="Move later" disabled="@(Busy||!CanEdit||Store.Active.Body.Episodes.IndexOf(selected)==Store.Active.Body.Episodes.Count-1)" @onclick="()=>Move(1)">↓</button></div></div>
<div class="media-well" data-rd-preserve><video @ref="Preview" controls playsinline preload="metadata" aria-label="Selected episode preview"></video>@if(CurrentBinding is null){<div class="media-empty"><span aria-hidden="true">▷</span><p>@(selected.File is null?"Choose a video to preview it.":"Reattach this video to preview or upload it.")</p></div>}</div>
<div class="media-details"><div><strong>@(CurrentBinding?.Name??selected.File?.Name??"No video selected")</strong><small>@MediaSummary(selected)</small></div><label class="button" for="rebind-video">@(selected.File is null?"Choose video":"Reattach video")</label><input class="visually-hidden" id="rebind-video" type="file" accept="video/*" @ref="RebindInput" @onchange="Rebind" disabled="@(Busy||!CanEdit)"></div>
@if(CurrentBinding is {Identified:false}){<div class="identify-row"><span>Identify the file before sharing this plan or uploading.</span><button disabled="@(Busy||!CanEdit)" @onclick="Identify">@(Identifying?"Identifying…":"Identify file")</button>@if(Identifying){<button @onclick="CancelIdentification">Cancel</button>}</div>}
@if(CurrentBinding is not null){<div class="frame-tools"><button disabled="@Busy" @onclick="CaptureFrame">Capture frame</button><span class="quiet">Pause the preview at the frame you want.</span></div>}@if(Frame is not null){<div class="captured-frame"><img src="@Frame.DataUrl" alt="Captured frame from the attached episode" data-appearance-preserve><button disabled="@Busy" @onclick="DownloadFrame">Download frame</button></div>}<div class="metadata-grid"><label id="title">Title <small>@selected.Title.Length / 100</small><input maxlength="100" @bind="selected.Title" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></label><label>Original language<input maxlength="35" placeholder="en" @bind="selected.DefaultLanguage" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></label><label class="wide" id="description">Description<textarea rows="5" maxlength="5000" @bind="selected.Description" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></textarea></label><label id="audience">Made for children?<select @bind="selected.MadeForKids" @bind:after="Changed" disabled="@(Busy||!CanEdit)"><option value="">Choose</option><option value="true">Yes</option><option value="false">No</option></select></label><label id="synthetic">Realistic altered or synthetic content?<select @bind="selected.ContainsSyntheticMedia" @bind:after="Changed" disabled="@(Busy||!CanEdit)"><option value="">Choose</option><option value="true">Yes</option><option value="false">No</option></select></label><label>Category<select @bind="selected.CategoryId" @bind:after="Changed" disabled="@(Busy||!CanEdit)">@if(!KnownCategories.Contains(selected.CategoryId)){<option value="@selected.CategoryId">Imported category @selected.CategoryId</option>}<option value="27">Education</option><option value="22">People &amp; Blogs</option><option value="1">Film &amp; Animation</option><option value="10">Music</option><option value="20">Gaming</option><option value="26">Howto &amp; Style</option><option value="28">Science &amp; Technology</option></select></label><label id="schedule">Planned release <small>your local time</small><input type="datetime-local" value="@PlannedTime(selected)" @onchange="SetTime" disabled="@(Busy||!CanEdit)"></label></div>
<details><summary>Translations <span class="count">@selected.Localizations.Count</span></summary><p class="quiet">Add titles and descriptions you have prepared in other languages.</p>@foreach(var text in selected.Localizations){<div class="translation-block" @key="text"><label>Language<input maxlength="35" placeholder="es" @bind="text.Language" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></label><label>Title<input maxlength="100" @bind="text.Title" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></label><label>Description<textarea rows="3" maxlength="5000" @bind="text.Description" @bind:after="Changed" disabled="@(Busy||!CanEdit)"></textarea></label><button disabled="@(Busy||!CanEdit)" @onclick="()=>RemoveTranslation(text)">Remove translation</button></div>}<button disabled="@(Busy||!CanEdit||selected.Localizations.Count>=20)" @onclick="AddTranslation">Add translation</button></details>
<details><summary>Tags</summary><label>Comma-separated tags<input value="@string.Join(", ",selected.Tags)" @onchange="SetTags" disabled="@(Busy||!CanEdit)"></label></details>
<details class="danger-zone"><summary>Remove this episode</summary><p>The original file is not deleted.</p><button disabled="@(Busy||!CanEdit)" @onclick="RemoveEpisode">Remove from release</button></details>
}else{<div class="inspector-empty"><h2>See what you are releasing.</h2><p>Add a video, then prepare its title, audience and release time.</p></div>}</section>
<aside class="preflight"><p class="eyebrow">Before delivery</p><h2>@(Store.Active.Body.Episodes.Count==0?"Start with a video":BlockingCount+" to resolve")</h2>@if(Store.Active.Body.Episodes.Count==0){<p>Add the first episode.</p>}else if(Issues.Count==0){<p>Local checks are clear. Delivery still requires an approved online version and an authorized channel.</p>}
<ul>@foreach(var issue in Issues){<li class="@(issue.BlocksUpload?"blocking":"advisory")"><button disabled="@Busy" @onclick="()=>Select(issue.EpisodeId)"><strong>@EpisodeName(issue.EpisodeId)</strong><span>@issue.Message</span></button></li>}</ul><a class="button" href="@(Store.Active.WorkspaceId is {} onlineId?"review/"+onlineId:"review")">Review with your team →</a><details><summary>What is in the package?</summary><p>Your episode descriptions, planned times and file identities. Videos and channel access are not included. Reattach the originals on another device.</p></details></aside></div>
@code {
 [Parameter]public string? Id{get;set;} ElementReference AddInput,RebindInput,Preview; IJSObjectReference? Media; string? SelectedId,MountedFile; bool Identifying,PreviewDirty=true,PreviewUpdating; string? HashingFileId; PendingSave? SaveAttempt; CapturedFrame? Frame;
 static readonly HashSet<string> KnownCategories=["27","22","1","10","20","26","28"];
 Episode? Selected=>Store.Active.Body.Episodes.FirstOrDefault(item=>item.Id==SelectedId);
 MediaBinding? CurrentBinding=>SelectedId is not null&&Store.Bindings.TryGetValue(SelectedId,out var binding)&&binding.LocalId==Store.Active.Id?binding:null;
 bool CanEdit=>Store.Editable;
 List<PreflightIssue> Issues=>ReleaseRules.Preflight(Store.Active.Body,Store.BoundEpisodes);
 int BlockingCount=>Issues.Count(item=>item.BlocksUpload);
 protected override async Task OnParametersSetAsync(){await Act(async()=>{await Store.Initialize();if(Id is not null&&Store.Online?.Id!=Id){var target=Id;var response=await Api.Get<WorkspaceEnvelope>("workspaces/"+target);if(Disposed||Id!=target)return;Store.Load(response.Workspace);await Store.Persist();}SelectedId=Store.Active.Body.Episodes.FirstOrDefault()?.Id;PreviewDirty=true;Frame=null;},allowWhileBusy:true);}
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(PreviewUpdating||Selected is null||!PreviewDirty&&CurrentBinding?.ClientFileId==MountedFile)return;
  PreviewUpdating=true;
  string? attemptedEpisode=SelectedId,attemptedFile=CurrentBinding?.ClientFileId;long attemptedGeneration=Store.Generation;
  try
  {
   Media??=await JS.InvokeAsync<IJSObjectReference>("import","./media.mjs");
   if(Disposed){await Media.DisposeAsync();Media=null;return;}
   while(!Disposed&&Selected is not null)
   {
    attemptedEpisode=SelectedId;attemptedGeneration=Store.Generation;attemptedFile=CurrentBinding?.ClientFileId;
    if(!PreviewDirty&&attemptedFile==MountedFile)break;
    if(attemptedFile is not null)await Media.InvokeVoidAsync("mountPreview",Preview,attemptedFile);
    else await Media.InvokeVoidAsync("clearPreview",Preview);
    if(Disposed)return;
    if(SelectedId==attemptedEpisode&&Store.Generation==attemptedGeneration&&CurrentBinding?.ClientFileId==attemptedFile){MountedFile=attemptedFile;PreviewDirty=false;break;}
    PreviewDirty=true;
   }
  }
  catch(JSException)
  {
   if(!Disposed&&SelectedId==attemptedEpisode&&Store.Generation==attemptedGeneration&&CurrentBinding?.ClientFileId==attemptedFile){MountedFile=attemptedFile;PreviewDirty=false;Message="This browser could not preview the video. Your release fields are still editable.";Failed=true;StateHasChanged();}
  }
  finally{PreviewUpdating=false;if(!Disposed&&PreviewDirty&&Selected is not null)await InvokeAsync(StateHasChanged);}
 }
 void Select(string id){SelectedId=id;PreviewDirty=true;Frame=null;}
 Task AddVideos()=>Act(async()=>{Media??=await JS.InvokeAsync<IJSObjectReference>("import","./media.mjs");var files=await Media.InvokeAsync<List<FileDescriptor>>("selectFiles",AddInput);await AddBatch(files);});
 Task TrySamples()=>Act(async()=>{Media??=await JS.InvokeAsync<IJSObjectReference>("import","./media.mjs");var files=await Media.InvokeAsync<List<FileDescriptor>>("loadSamples");await AddBatch(files);Message="Sample clips added.";});
 async Task AddBatch(List<FileDescriptor> files){if(Store.Active.Body.Episodes.Count+files.Count>40){foreach(var file in files)await Media!.InvokeVoidAsync("releaseFile",file.ClientFileId);throw new InvalidDataException("A release can contain up to 40 episodes.");}var localId=Store.Active.Id;List<(Episode Episode,MediaBinding Binding)> pending=[];try{foreach(var file in files){var episode=new Episode{Title=System.IO.Path.GetFileNameWithoutExtension(file.Name)};if(episode.Title.Length>100)episode.Title=episode.Title[..100];pending.Add((episode,await Inspect(file,localId)));}}catch{foreach(var file in files)await Media!.InvokeVoidAsync("releaseFile",file.ClientFileId);throw;}if(Store.Active.Id!=localId||Disposed){foreach(var file in files)await Media!.InvokeVoidAsync("releaseFile",file.ClientFileId);return;}foreach(var item in pending){Store.Active.Body.Episodes.Add(item.Episode);Store.Bindings[item.Episode.Id]=item.Binding;SelectedId??=item.Episode.Id;}Store.MarkChanged();await Store.Persist();}
 async Task<MediaBinding> Inspect(FileDescriptor file,string localId){var info=await Media!.InvokeAsync<MediaInspection>("inspectFile",file.ClientFileId);return new(){LocalId=localId,ClientFileId=file.ClientFileId,Name=file.Name,Size=file.Size,LastModified=file.LastModified,MimeType=info.MimeType.Length>0?info.MimeType:file.MimeType,DurationMs=info.DurationMs,Width=info.Width,Height=info.Height};}
 Task Rebind()=>Act(async()=>
 {
  if(Selected is not {} episode)return;
  var localId=Store.Active.Id;var generation=Store.Generation;
  Media??=await JS.InvokeAsync<IJSObjectReference>("import","./media.mjs");
  var files=await Media.InvokeAsync<List<FileDescriptor>>("selectFiles",RebindInput);if(files.Count==0)return;
  bool accepted=false;
  try
  {
   var binding=await Inspect(files[0],localId);
   if(Disposed||Store.Active.Id!=localId||Store.Generation!=generation||SelectedId!=episode.Id)return;
   Store.Bindings.TryGetValue(episode.Id,out var previous);
   Store.Bindings[episode.Id]=binding;accepted=true;PreviewDirty=true;Frame=null;
   if(previous is not null)await Media.InvokeVoidAsync("releaseFile",previous.ClientFileId);
   Message="Preview ready. Identify the file to confirm the match.";
  }
  finally{foreach(var file in files.Skip(accepted?1:0))await Media.InvokeVoidAsync("releaseFile",file.ClientFileId);}
 });
 Task Identify()=>Act(async()=>{if(Selected is not {} episode||CurrentBinding is not {} binding)return;var generation=Store.Generation;Identifying=true;HashingFileId=binding.ClientFileId;try{var result=await Media!.InvokeAsync<FileFingerprint>("fingerprintFile",binding.ClientFileId);if(Disposed||Store.Generation!=generation)return;if(episode.File is {} expected&&!ReleaseRules.Matches(expected,result.Algorithm,result.Fingerprint,result.Size))throw new InvalidDataException("This is a different video. Choose the original matching file, or add the new video as another episode.");episode.File=new(){Name=binding.Name,Size=result.Size,LastModified=binding.LastModified,Mime=binding.MimeType,Algorithm=result.Algorithm,Fingerprint=result.Fingerprint,Duration=binding.DurationMs/1000,Width=binding.Width,Height=binding.Height};binding.Identified=true;Store.MarkChanged();await Store.Persist();Message="File identified. This video is ready for the remaining checks.";}finally{Identifying=false;HashingFileId=null;}});
 async Task CancelIdentification(){if(CurrentBinding is {} binding&&Media is not null)try{await Media.InvokeVoidAsync("cancelFingerprint",binding.ClientFileId);}catch(JSException){Message="The identification could not be canceled. Wait for its result before continuing.";Failed=true;}}
 Task CaptureFrame()=>Act(async()=>{if(CurrentBinding is not {} binding)return;Media??=await JS.InvokeAsync<IJSObjectReference>("import","./media.mjs");var time=await Media.InvokeAsync<double>("previewTime",Preview);var result=await Media.InvokeAsync<CapturedFrame>("thumbnail",binding.ClientFileId,time,640);if(!Disposed&&CurrentBinding?.ClientFileId==result.ClientFileId)Frame=result;});
 Task DownloadFrame()=>Act(()=>Frame is null?Task.CompletedTask:Store.DownloadFrame(Frame.DataUrl),"Frame downloaded.");
 Task Move(int delta)=>Act(async()=>{if(Selected is not {} selected)return;var list=Store.Active.Body.Episodes;var current=list.IndexOf(selected);var next=current+delta;if(next<0||next>=list.Count)return;list.RemoveAt(current);list.Insert(next,selected);Store.MarkChanged();await Store.Persist();});
 Task RemoveEpisode()=>Act(async()=>{if(Selected is not {} episode)return;Store.Active.Body.Episodes.Remove(episode);if(Store.Bindings.Remove(episode.Id,out var binding)&&Media is not null)await Media.InvokeVoidAsync("releaseFile",binding.ClientFileId);SelectedId=Store.Active.Body.Episodes.FirstOrDefault()?.Id;PreviewDirty=true;Frame=null;Store.MarkChanged();await Store.Persist();});
 Task AddTranslation()=>Act(async()=>{Selected?.Localizations.Add(new());Store.MarkChanged();await Store.Persist();});
 Task RemoveTranslation(Translation item)=>Act(async()=>{Selected?.Localizations.Remove(item);Store.MarkChanged();await Store.Persist();});
 Task SetTags(ChangeEventArgs args)=>Act(async()=>{if(Selected is {} episode)episode.Tags=(args.Value?.ToString()??"").Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).ToList();Store.MarkChanged();await Store.Persist();});
 Task SetTime(ChangeEventArgs args)=>Act(async()=>{if(Selected is not {} episode)return;var value=args.Value?.ToString();if(string.IsNullOrWhiteSpace(value))episode.PublishAt=null;else if(DateTime.TryParse(value,System.Globalization.CultureInfo.InvariantCulture,System.Globalization.DateTimeStyles.AssumeLocal,out var parsed))episode.PublishAt=new DateTimeOffset(parsed).ToUniversalTime();else throw new InvalidDataException("Choose a valid local release time.");Store.MarkChanged();await Store.Persist();});
 static string PlannedTime(Episode episode)=>episode.PublishAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")??"";
 string EpisodeName(string id)=>Store.Active.Body.Episodes.FirstOrDefault(item=>item.Id==id)?.Title is {Length:>0} title?title:"Untitled episode";
 string FileStatus(Episode episode)=>Store.BoundEpisodes.Contains(episode.Id)?"File matched":episode.File is not null?"Reattach video":Store.Bindings.TryGetValue(episode.Id,out var binding)&&binding.LocalId==Store.Active.Id?"Preview ready · identify file":"Add video";
 string MediaSummary(Episode episode){var seconds=CurrentBinding?.DurationMs/1000??episode.File?.Duration;var width=CurrentBinding?.Width??episode.File?.Width;var height=CurrentBinding?.Height??episode.File?.Height;var size=CurrentBinding?.Size??episode.File?.Size;return string.Join(" · ",new[]{seconds is {} duration?TimeSpan.FromSeconds(duration).ToString(@"hh\:mm\:ss"):null,width is not null&&height is not null?width+" × "+height:null,size is {} bytes?(bytes/1048576d).ToString("N1")+" MB":null}.Where(value=>value is not null));}
 Task DownloadProject()=>Act(()=>Store.Download("release-project.json",ReleaseRules.Export(Store.Active.Body)),"Project file downloaded. Reattach the originals when opening it elsewhere.");
 Task Package()=>Act(Store.DownloadPackage,"Release package downloaded. Videos are supplied separately.");
 Task LocalCopy()=>Act(async()=>{Store.New(ReleaseRules.Clone(Store.Active.Body));SelectedId=Store.Active.Body.Episodes.FirstOrDefault()?.Id;PreviewDirty=true;await Store.Persist();Navigation.NavigateTo("workspace");});
 Task SaveOnline()=>Act(async()=>{var json=ReleaseRules.Export(Store.Active.Body);var generation=Store.Generation;var local=Store.Active;if(SaveAttempt is not null&&SaveAttempt.Json!=json)throw new InvalidDataException("An earlier save has not been confirmed. Check your online releases before saving changed content.");SaveAttempt??=new(Guid.NewGuid().ToString(),json,local.WorkspaceId,local.Revision);var body=JsonSerializer.Deserialize<ReleaseProject>(SaveAttempt.Json,ReleaseRules.PortableJson)!;WorkspaceEnvelope result;try{result=SaveAttempt.WorkspaceId is null?await Api.Post<WorkspaceEnvelope>("workspaces",new{requestId=SaveAttempt.RequestId,body}):await Api.Post<WorkspaceEnvelope>("workspaces/"+SaveAttempt.WorkspaceId,new{requestId=SaveAttempt.RequestId,revision=SaveAttempt.Revision,body});}catch(ReleaseFailure error)when((int)error.Status is >=400 and <500){SaveAttempt=null;throw;}if(Disposed||Store.Generation!=generation)return;SaveAttempt=null;Store.Saved(result.Workspace);await Store.Persist();Message="Saved online. Review this version before delivery.";});
 public async ValueTask DisposeAsync(){base.Dispose();if(Media is not null){try{if(HashingFileId is not null)await Media.InvokeVoidAsync("cancelFingerprint",HashingFileId);await Media.InvokeVoidAsync("clearPreview",Preview);await Media.DisposeAsync();}catch(JSException){if(Store.DiagnosticLogging)Console.Error.WriteLine("Media cleanup was not confirmed.");}}}
 sealed record PendingSave(string RequestId,string Json,string? WorkspaceId,int? Revision);
}
